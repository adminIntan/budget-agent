# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Channel Discord yang Diizinkan (Opsional):
# Masukkan ID channel yang diizinkan (dipisahkan koma). 
# Direct Message (DM) tetap diizinkan secara otomatis.
# Kosongkan jika ingin bot bisa merespons di semua channel server.
DISCORD_ALLOWED_CHANNELS=1551875387615608852

# Pembatasan Pengguna / Otorisasi Hybrid (Opsional):
# 1. DISCORD_ALLOWED_USERS: Masukkan User ID Discord dipisahkan koma (contoh: 123456789012345678).
#    Bisa dikosongkan jika ingin menggunakan Role saja atau belum dibatasi.
DISCORD_ALLOWED_USERS=

# 2. DISCORD_ALLOWED_ROLES: Masukkan Nama Role atau Role ID server dipisahkan koma.
#    Contoh: Finance, Management, Admin
DISCORD_ALLOWED_ROLES=

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Cloud Platform & BigQuery Configuration
GCP_PROJECT_ID=intanglass

# Konfigurasi Dataset BigQuery:
# Anda dapat memasukkan 1 atau 2 dataset (atau lebih) dipisahkan tanda koma.
# Contoh 2 dataset: mrt_procurement,dataset_keuangan
BIGQUERY_DATASET=mrt_procurement,dataset_keuangan

# Filter Tabel yang Diizinkan (BIGQUERY_ALLOWED_TABLES):
# - Minimal 1 tabel (contoh: department_budgets).
# - Jika ingin menambah tabel kedepannya, cukup tambahkan nama tabel dipisahkan tanda koma.
# - Format yang didukung:
#   * Nama tabel saja: department_budgets,budget_transactions
#   * Nama dataset.tabel: mrt_procurement.department_budgets,dataset_keuangan.laporan_kas
# - Kosongkan jika ingin mengizinkan SEMUA tabel yang ada pada schema_definition.json.
BIGQUERY_ALLOWED_TABLES=department_budgets,budget_transactions

# Kredensial Service Account GCP (Pengujian Lokal)
# Masukkan nama/path file JSON Service Account yang telah Anda unduh dari GCP Console.
# Contoh: service_account.json (jika file ditaruh di folder project ini)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
